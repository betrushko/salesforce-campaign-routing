<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Assign_specific_PaymentHub_campaign</name>
        <label>Assign PaymentHub source Campaign</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>PaymentHubCampaignAssignment</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>opportunityId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>PaymentHubCampaignAssignment</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Assigns CampaignId for Opportunities created by PaymentHub by matching Opportunity.Campa_a_de_origen__c exactly to Campaign.Name. When a related Recurring Donation exists, its lookup is evaluated independently from Recurring Donation.Campa_a_de_origen__c, with the Opportunity target used only when the RD source is blank.</description>
    <interviewLabel>PaymentHub - assign source Campaign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PaymentHub - Assign source Campaign</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_specific_PaymentHub_campaign</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND 4</filterLogic>
        <filters>
            <field>LeadSource</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>PaymentHub</stringValue>
            </value>
        </filters>
        <filters>
            <field>Auth__c</field>
            <operator>StartsWith</operator>
            <value>
                <stringValue>DEMO-FH-</stringValue>
            </value>
        </filters>
        <filters>
            <field>Campa_a_de_origen__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Transaccion__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
